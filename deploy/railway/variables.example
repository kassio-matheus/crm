# Railway raw variable editor. Service names here: Twenty, Postgres, Redis, Storage.
# Generate new secrets privately. Do not paste this example's placeholders as real values.
NODE_ENV=production
NODE_PORT=3000
PORT=3000
SERVER_URL=https://${{Twenty.RAILWAY_PUBLIC_DOMAIN}}
PG_DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_BASE64_32_BYTES
APP_SECRET=REPLACE_WITH_ANOTHER_RANDOM_BASE64_32_BYTES
IS_MULTIWORKSPACE_ENABLED=false
IS_CONFIG_VARIABLES_IN_DB_ENABLED=false
IS_BILLING_ENABLED=false
SIGN_IN_PREFILLED=false
STORAGE_TYPE=s3
STORAGE_S3_ENDPOINT=${{Storage.ENDPOINT}}
STORAGE_S3_NAME=${{Storage.BUCKET}}
STORAGE_S3_REGION=${{Storage.REGION}}
STORAGE_S3_ACCESS_KEY_ID=${{Storage.ACCESS_KEY_ID}}
STORAGE_S3_SECRET_ACCESS_KEY=${{Storage.SECRET_ACCESS_KEY}}
CODE_INTERPRETER_TYPE=DISABLED
# The complete IaC stack generates secrets and sets this single-company profile.
LOGIC_FUNCTION_TYPE=LOCAL
TRUSTED_LOCAL_FUNCTIONS=true
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PRESIGNED_URL_ENABLED=false
# Server only:
TWENTY_PROCESS=server
DISABLE_DB_MIGRATIONS=false
DISABLE_CRON_JOBS_REGISTRATION=false
# Worker references shared settings from Twenty, with these overrides:
# TWENTY_PROCESS=worker
# TWENTY_INTERNAL_URL=http://${{Twenty.RAILWAY_PRIVATE_DOMAIN}}:3000
# DISABLE_DB_MIGRATIONS=true
# DISABLE_CRON_JOBS_REGISTRATION=true
# Optional SMTP configuration on Twenty (preserved by future IaC applies):
EMAIL_DRIVER=LOGGER
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=CRM
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_NO_TLS=false
# Set EMAIL_DRIVER=SMTP only after entering real provider credentials.
# AI_PROVIDERS is configured privately in Railway, never committed with API keys.
